@page "/communications"
@using global::App.Shared.Dtos
@inject NavigationManager NavigationManager

@inject IServerAppClient Client


<h3>Communications List</h3>

<UseCommunications Context="result" PageSize="@pageSize" After="@cursor">
    <ChildContent>
        @* Map and assign inside a void block *@
        @{
            MapCommunications(result);
        }

        @if (items.Count == 0)
        {
            <p>No communications found.</p>
        }
        else
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Current Status</th>
                        <th>Last Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var comm in items)
                    {
                        <tr>
                            <td>@comm.Title</td>
                            <td>@comm.TypeCode</td>
                            <td>@comm.CurrentStatus</td>
                            <td>@comm.LastUpdatedUtc.ToLocalTime().ToString("g")</td>
                            <td>
                                <button class="btn btn-link" @onclick="() => ViewDetails(comm.Id)">View Details</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
    <ErrorContent>
        Something went wrong: @result.First().Message
    </ErrorContent>
    <LoadingContent>
        Loading ...
    </LoadingContent>
</UseCommunications>

<div class="mt-3">
    <button class="btn btn-secondary" @onclick="PrevPage" disabled="@IsFirstPage">Previous</button>
    <span class="mx-2">Page @currentPage</span>
    <button class="btn btn-secondary" @onclick="NextPage" disabled="@hasNextPage">Next</button>
</div>

@code {
    private List<CommunicationDto> items = new();
    private string? cursor;
    private string? nextCursor;
    private Stack<string?> cursorStack = new();
    private int currentPage = 1;
    private int pageSize = 10;
    private bool hasNextPage = false;

    private bool IsFirstPage => cursorStack.Count == 0;
    
    private void MapCommunications(ServerApp.GraphQL.ICommunicationsResult? result)
    {
        if (result?.Communications == null)
        {
            items = new List<CommunicationDto>();
            hasNextPage = false;
            nextCursor = null;
            return;
        }

        items = result.Communications.Edges
            .Select(e => new CommunicationDto
            {
                Id = e.Node.Id,
                Title = e.Node.Title,
                TypeCode = e.Node.TypeCode,
                CurrentStatus = e.Node.CurrentStatus,
                LastUpdatedUtc = e.Node.LastUpdatedUtc.UtcDateTime
            }).ToList();

        nextCursor = result.Communications.PageInfo.EndCursor;
        hasNextPage = result.Communications.PageInfo.HasNextPage;
    }

    private void NextPage()
    {
        if (hasNextPage)
        {
            cursorStack.Push(cursor);
            cursor = nextCursor;
            currentPage++;
            StateHasChanged();
        }
    }

    private void PrevPage()
    {
        if (cursorStack.Count > 0)
        {
            cursor = cursorStack.Pop();
            currentPage--;
            StateHasChanged();
        }
    }

    private void ViewDetails(Guid id)
    {
        NavigationManager.NavigateTo($"/communications/{id}");
    }
}
